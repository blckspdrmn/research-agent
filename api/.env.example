AZURE_OPENAI_BASE_URL=https://<リソース名>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<控えたキー>
AZURE_OPENAI_CHAT_DEPLOYMENT=chat-mini
TAVILY_API_KEY=tvly-xxxx
ENTRA_ISSUER=https://<テナントID>.ciamlogin.com/<テナントID>/v2.0  # discoveryのissuer
ENTRA_JWKS_URL=https://<テナントID>.ciamlogin.com/<テナントID>/discovery/v2.0/keys  # discoveryのjwks_uri
ENTRA_API_CLIENT_ID=<APIのclient-id>
ENTRA_REQUIRED_SCOPE=access_as_user
